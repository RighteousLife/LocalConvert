    "All conversions happen locally on your Mac. No data is sent to the cloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All conversions happen locally on your Mac. No data is sent to the cloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dönüşümler Mac'inizde yerel olarak gerçekleşir. Buluta hiçbir veri gönderilmez."
          }
        }
      }
    },
    "All file processing occurs 100% locally and offline on your Mac. LocalConvert never uploads or transmits your files, telemetry, or metadata to external servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All file processing occurs 100% locally and offline on your Mac. LocalConvert never uploads or transmits your files, telemetry, or metadata to external servers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dosya işlemleri Mac'inizde %100 yerel ve çevrimdışı gerçekleşir. LocalConvert dosyalarınızı, telemetriyi veya üst verileri asla harici sunuculara yüklemez ya da iletmez."
          }
        }
      }
    },
